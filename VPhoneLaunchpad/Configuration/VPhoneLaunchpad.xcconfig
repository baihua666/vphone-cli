// The app. Build configuration (Development or Release) comes from the
// project level; this file only names the product.

PRODUCT_NAME = vphone-launchpad
// PRODUCT_NAME has a dash, which is not a valid Swift module name.
PRODUCT_MODULE_NAME = VPhoneLaunchpad
PRODUCT_BUNDLE_IDENTIFIER = com.vphone.launchpad
// Hand-written so SMPrivilegedExecutables can carry the helper requirement.
// Outside the synchronized group: a build input, not a bundled resource.
GENERATE_INFOPLIST_FILE = NO
INFOPLIST_FILE = Resources/VPhoneLaunchpad.Info.plist
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks
// VPhoneLaunchpad/AppIcon.icon, an Icon Composer document with light, dark
// and tinted appearances. actool merges CFBundleIconName into the plist.
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
// Same languages and String Catalog setup as VPhone.bundle: English source,
// with zh-Hans, ja, ko and vi in VPhoneLaunchpad/Localizable.xcstrings and
// VPhoneLaunchpad/InfoPlist.xcstrings.
SWIFT_EMIT_LOC_STRINGS = YES

// Local application library and ARM Store integration; clear to disable.
VPHONE_APPLICATION_MANAGEMENT = VPHONE_CUSTOM_APPLICATION_MANAGEMENT
VPHONE_TEMPORARY_INSTALL_MEMORY = VPHONE_CUSTOM_TEMPORARY_INSTALL_MEMORY

// Release catalog, onboarding and image distribution. Clear to disable.
VPHONE_DISTRIBUTION = VPHONE_CUSTOM_DISTRIBUTION
VPHONE_DISTRIBUTION_REVISION = 0
VPHONE_DISTRIBUTION_SIGNING = notarized
// Clear to retain manual App installer downloads.
VPHONE_APP_UPDATE = VPHONE_CUSTOM_APP_UPDATE
VPHONE_LOCAL_IMAGES = VPHONE_CUSTOM_LOCAL_IMAGES
// Private installers may seed local Decodo settings; public packages carry no credentials.
VPHONE_DECODO_PRIVATE_DEFAULTS = VPHONE_CUSTOM_DECODO_PRIVATE_DEFAULTS
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) $(VPHONE_APPLICATION_MANAGEMENT) $(VPHONE_TEMPORARY_INSTALL_MEMORY) $(VPHONE_DISTRIBUTION) $(VPHONE_APP_UPDATE) $(VPHONE_LOCAL_IMAGES) $(VPHONE_DECODO_PRIVATE_DEFAULTS)
